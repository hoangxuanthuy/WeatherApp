<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Styles hiện tại của bạn - GIỮ NGUYÊN -->
    <style name="HeaderTitle">
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">#212121</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="WeatherTemp">
        <item name="android:textSize">48sp</item>
        <item name="android:textColor">#212121</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="WeatherDescription">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">#666666</item>
    </style>

    <!-- ========== STYLES MỚI ĐƯỢC THÊM VÀO (KHÔNG CẦN FONT) ========== -->

    <!-- Bottom Navigation Text Styles -->
    <style name="BottomNavTextActive" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="BottomNavTextInactive" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">normal</item>
    </style>

    <!-- Card Styles -->
    <style name="WeatherCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">8dp</item>
        <item name="cardBackgroundColor">@android:color/white</item>
        <item name="android:layout_margin">8dp</item>
    </style>

    <style name="WeatherCard.Large">
        <item name="cardCornerRadius">24dp</item>
        <item name="cardElevation">12dp</item>
        <item name="android:layout_margin">12dp</item>
    </style>

    <!-- Enhanced Text Styles -->
    <style name="SectionTitle" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#1F2937</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="SubTitle" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">#6B7280</item>
    </style>

    <!-- Search Bar Styles -->
    <style name="SearchBarStyle">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">#1F2937</item>
        <item name="android:textColorHint">#9CA3AF</item>
    </style>

    <!-- Icon Button Styles -->
    <style name="IconButtonStyle">
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:padding">12dp</item>
    </style>

    <!-- Weather Detail Text Styles -->
    <style name="WeatherDetailLabel">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">#6B7280</item>
    </style>

    <style name="WeatherDetailValue">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">#1F2937</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Hourly Forecast Styles -->
    <style name="HourlyTime">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">#6B7280</item>
    </style>

    <style name="HourlyTemp">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">#1F2937</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Air Quality Styles -->
    <style name="AirQualityIndex">
        <item name="android:textSize">32sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="AirQualityLabel">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">#6B7280</item>
    </style>

    <!-- Button Styles -->
    <style name="PrimaryButton" parent="Widget.MaterialComponents.Button">
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">#4F46E5</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:elevation">4dp</item>
    </style>

    <style name="SecondaryButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textColor">#4F46E5</item>
        <item name="android:textStyle">bold</item>
        <item name="strokeColor">#4F46E5</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <!-- Card Header Styles -->
    <style name="CardHeaderTitle">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#1F2937</item>
    </style>

    <!-- Small Text Styles -->
    <style name="SmallText">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">#9CA3AF</item>
    </style>

    <style name="MediumText">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">#4B5563</item>
    </style>

    <!-- Status Text Styles -->
    <style name="SuccessText">
        <item name="android:textColor">#10B981</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="WarningText">
        <item name="android:textColor">#F59E0B</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ErrorText">
        <item name="android:textColor">#EF4444</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>